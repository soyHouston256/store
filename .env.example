# ============================================================================
# Root .env — used by BOTH:
#   1. docker compose (all variables below; copy to .env and fill in)
#   2. the storefront's local `npm run dev` at the repo root, which reads
#      ONLY VITE_API_URL from this same file (vite ignores the rest)
# ⚠ docker compose interpolates `$` inside unquoted values: SINGLE-QUOTE the
# bcrypt hash (or double every `$` as `$$`) or it gets silently mangled.
# ============================================================================

# Public API origin, WITHOUT trailing slash.
# ⚠ BUILD-TIME value: vite bakes it into the storefront and backoffice bundles
# when their images are built — after changing it run:
#   docker compose build storefront backoffice && docker compose up -d
# Prod: https://api.$DOMAIN     Local dev: http://localhost:3000
VITE_API_URL=http://localhost:3000

# Public storefront origin used by the backoffice for WhatsApp tracking links.
# ⚠ BUILD-TIME value like VITE_API_URL (baked into the backoffice bundle).
# Optional — falls back to http://store.localhost when unset.
# Prod: https://store.$DOMAIN
VITE_STORE_URL=

# Apex domain served by Caddy (subdomains store./admin./api. are created on
# it — DNS A records for the three must point at this host).
# DOMAIN=localhost works for local smoke tests (Caddy internal CA, curl -k).
DOMAIN=example.com

# Mongo connection string; `mongo` is the compose service hostname.
MONGO_URI=mongodb://mongo:27017/store

# API port inside the network (Caddy proxies api.$DOMAIN → api:3000).
PORT=3000

# JWT signing secret — long random string, e.g.: openssl rand -base64 48
JWT_SECRET=

# Token lifetime (jsonwebtoken duration string).
JWT_EXPIRES_IN=12h

# Single admin account (no admin collection — env only).
ADMIN_USER=admin

# bcrypt hash of the admin password. Generate it with the api script:
#   cd api && npm ci && npm run build
#   node dist/scripts/hash-admin-password.js 'your-password-here'
# (or without building: npx tsx src/scripts/hash-admin-password.ts 'your-password-here')
# Paste the printed hash WRAPPED IN SINGLE QUOTES — compose otherwise
# interpolates the $ signs and the login will never match:
# ADMIN_PASSWORD_HASH='$2b$12$abcdefghijklmnopqrstuvwxyz012345678901234567890123456'
ADMIN_PASSWORD_HASH=

# Where the api stores uploaded logos (named volume uploads_data in compose).
UPLOAD_DIR=/data/uploads

# Comma-separated exact-match CORS allowlist: the two frontend origins.
# Prod:  https://store.example.com,https://admin.example.com
# Local dev (vite servers): http://localhost:3001,http://localhost:5173
CORS_ORIGINS=https://store.example.com,https://admin.example.com

# WhatsApp number (country code + number, no "+") used by the storefront for
# order/contact links. BUILD-TIME like the other VITE_ vars.
VITE_WHATSAPP_NUMBER=51962940579
