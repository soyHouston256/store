# Backoffice env — BUILD-TIME values: vite bakes them into the bundle.
# In docker they must be passed as build args (see backoffice/Dockerfile and
# docker-compose.yml); changing them requires `docker compose build backoffice`.
# For local `npm run dev`, copy this file to backoffice/.env.

# API origin, WITHOUT trailing slash (same value as the root .env).
VITE_API_URL=http://localhost:3000

# Public storefront origin, WITHOUT trailing slash — used for the customer
# tracking link in WhatsApp messages ("Sigue tu pedido: $VITE_STORE_URL/pedido/<id>").
# Prod: https://store.$DOMAIN   Fallback if unset: http://store.localhost
VITE_STORE_URL=http://store.localhost
