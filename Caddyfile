# Caddy reverse proxy (design §8): subdomain routing with automatic TLS.
# $DOMAIN comes from the caddy service environment (root .env).
#
# DNS: create A/AAAA records for store.$DOMAIN, admin.$DOMAIN and api.$DOMAIN
# pointing at this host; Caddy then provisions Let's Encrypt certs on its own.
#
# /uploads is served by the API itself so its security headers
# (CSP sandbox / nosniff — set in express) reach the browser untouched;
# do NOT serve uploads from Caddy or nginx directly.

store.{$DOMAIN} {
	reverse_proxy storefront:80
}

admin.{$DOMAIN} {
	reverse_proxy backoffice:80
}

api.{$DOMAIN} {
	reverse_proxy api:3000
}

# ── Local testing variant (no public DNS) ────────────────────────────────
# Setting DOMAIN=localhost in .env makes the blocks above serve
# store.localhost / admin.localhost / api.localhost with Caddy's internal
# CA (browser warning or `curl -k`). For plain HTTP instead, comment the
# blocks above and uncomment:
#
http://store.localhost {
	reverse_proxy storefront:80
}
http://admin.localhost {
	reverse_proxy backoffice:80
}
http://api.localhost {
	reverse_proxy api:3000
}
