# Local full-stack Docker bring-up (DOMAIN=localhost, plain HTTP via Caddy).
# Built from .env.example — see README.docker.md.

# Base URL of the store API (no trailing slash). BUILD-TIME for the docker
# frontend images. http://api.localhost resolves to 127.0.0.1 in browsers
# (Caddy proxies it to api:3000). For local vite dev against the dockerized
# api you can switch this back to http://localhost:3000 (port 3000 is not
# published in the full prod-style stack, though — use the dev overlay then).
VITE_API_URL=http://api.localhost

# Apex domain served by Caddy; localhost → store.localhost / admin.localhost /
# api.localhost (plain-HTTP variant enabled in the Caddyfile).
DOMAIN=localhost

MONGO_URI=mongodb://mongo:27017/store
PORT=3000

JWT_SECRET=56c82ec64d92b4c43ff635e9ecc17adbc54b6b91cec718c26297687318b2fe47
JWT_EXPIRES_IN=12h

# Single admin account. Password: admin123 (bcrypt cost 12).
# Hash SINGLE-QUOTED so compose does not interpolate the $ signs.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH='$2b$12$lpmxCGNX7lilQheDmbPQ9er2xtpxFw.rITOL9xB4F1dLJ6b3tiud6'

UPLOAD_DIR=/data/uploads

# Docker frontends via Caddy + local vite dev servers, all allowed.
CORS_ORIGINS=http://store.localhost,http://admin.localhost,http://localhost:3001,http://localhost:5173
